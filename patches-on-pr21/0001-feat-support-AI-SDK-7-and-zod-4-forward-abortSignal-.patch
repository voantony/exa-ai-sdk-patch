@@ -134,7 +196,7 @@ export function webSearch<TOutput = unknown>(
       }
 
       try {
-        const response = await fetch("https://api.exa.ai/search", {
+        const response = await (customFetch ?? globalThis.fetch)(EXA_SEARCH_URL, {
           method: "POST",
           headers: {
             "Content-Type": "application/json",
@@ -143,15 +205,25 @@ export function webSearch<TOutput = unknown>(
