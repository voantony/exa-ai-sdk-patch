+// Copied from https://exa.ai/docs/integrations/vercel/ai-sdk ("Quick start" and
+// "Configure search"). The model is replaced by the AI SDK test model so this
+// file type-checks without a provider package.
+import { generateText, stepCountIs } from "ai";
+import { MockLanguageModelV3 } from "ai/test";
+import { webSearch, type ExaSearchConfig } from "@exalabs/ai-sdk";
+
+const model = new MockLanguageModelV3();
+
+export async function quickstart() {
+  const { text } = await generateText({
+    model,
+    prompt: "Tell me the latest developments in AI",
+    system: "Only use web search once per turn. Answer based on the information you have.",
+    tools: {
+      webSearch: webSearch(),
+    },
+    stopWhen: stepCountIs(3),
+  });
+  return text;
+}
+
+export async function configure() {
+  const { text } = await generateText({
+    model,
+    prompt: "Find the top AI companies in Europe founded after 2018",
+    tools: {
+      webSearch: webSearch({
+        type: "auto",
+        numResults: 6,
+        category: "company",
+        contents: {
+          text: { maxCharacters: 1000 },
+          maxAgeHours: 1,
+          summary: true,
+        },
+      }),
+    },
+    stopWhen: stepCountIs(5),
+  });
+  return text;
+}
+
+const config: ExaSearchConfig = {
+  numResults: 10,
+  type: "auto",
+};
+export const search = webSearch(config);
diff --git a/test/compat/run.mjs b/test/compat/run.mjs
new file mode 100644
index 0000000..6a54f7d
--- /dev/null
+++ b/test/compat/run.mjs
@@ -0,0 +1,71 @@
+// Installs the packed package into fresh projects for each supported ai/zod
+// combination (plain `npm install`, no --legacy-peer-deps), then type-checks
+// the Exa docs example and runs consumer.test.mjs.
+//
+//   node test/compat/run.mjs              # test this checkout
+//   node test/compat/run.mjs --baseline   # test the published 2.1.0 for comparison
+import { execFileSync } from "node:child_process";
+import { mkdtempSync, writeFileSync, copyFileSync, readdirSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, dirname, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const here = dirname(fileURLToPath(import.meta.url));
+const root = resolve(here, "../..");
+const baseline = process.argv.includes("--baseline");
+const matrix = [
+  { ai: "6", zod: "3" },
+  { ai: "6", zod: "4" },
+  { ai: "7", zod: "3" },
+  { ai: "7", zod: "4" },
+];
+
+let pkgSpec = "@exalabs/ai-sdk@2.1.0";
+if (!baseline) {
+  execFileSync("npm", ["run", "build"], { cwd: root, stdio: "ignore" });
+  const out = execFileSync("npm", ["pack", "--silent", "--pack-destination", tmpdir()], { cwd: root }).toString().trim().split("\n").pop();
+  pkgSpec = join(tmpdir(), out);
+}
+
+const sh = (cmd, args, cwd) => {
+  try {
+    return { ok: true, out: execFileSync(cmd, args, { cwd, stdio: "pipe", env: { ...process.env, EXA_API_KEY: "" } }).toString() };
+  } catch (e) {
+    return { ok: false, out: (e.stdout?.toString() ?? "") + (e.stderr?.toString() ?? "") };
+  }
+};
+
+const summary = [];
+for (const { ai, zod } of matrix) {
+  const dir = mkdtempSync(join(tmpdir(), `exa-ai-sdk-ai${ai}-zod${zod}-`));
+  writeFileSync(join(dir, "package.json"), JSON.stringify({ name: "consumer", private: true, type: "module" }));
+  writeFileSync(join(dir, "tsconfig.json"), JSON.stringify({
+    compilerOptions: { target: "ES2022", module: "NodeNext", moduleResolution: "NodeNext", strict: true, noEmit: true, skipLibCheck: true, types: ["node"] },
+    include: ["docs-example.ts"],
+  }));
+  copyFileSync(join(here, "consumer.test.mjs"), join(dir, "consumer.test.mjs"));
+  copyFileSync(join(here, "docs-example.ts"), join(dir, "docs-example.ts"));
+  const label = `ai@${ai} zod@${zod}`;
+  const install = sh("npm", ["install", "--no-audit", "--no-fund", pkgSpec, `ai@${ai}`, `zod@${zod}`, "typescript@5", "@types/node@22"], dir);
+  if (!install.ok) {
+    summary.push({ label, install: "FAIL", types: "-", runtime: "-", detail: install.out.split("\n").filter((l) => /ERESOLVE|peer ai|Found: ai/.test(l)).slice(0, 3).join(" | ") });
+    continue;
+  }
+  const versions = sh("npm", ["ls", "ai", "zod", "@exalabs/ai-sdk", "--depth=0"], dir).out.trim().split("\n").slice(1).join(", ");
+  const tsc = sh("npx", ["tsc", "-p", "."], dir);
+  const run = sh("node", ["--test", "consumer.test.mjs"], dir);
+  const pass = /(?:#|ℹ) pass (\d+)/.exec(run.out)?.[1] ?? "?";
+  const fail = /(?:#|ℹ) fail (\d+)/.exec(run.out)?.[1] ?? "?";
+  summary.push({
+    label,
+    install: "ok",
+    types: tsc.ok ? "ok" : "FAIL",
+    runtime: `${pass} pass / ${fail} fail`,
+    detail: [versions.replace(/[├└│─┬ ]+/g, " ").trim(), tsc.ok ? "" : tsc.out.split("\n").filter(Boolean).slice(0, 2).join(" | ")].filter(Boolean).join(" ; "),
+  });
+  if (!run.ok && process.env.VERBOSE) console.log(run.out);
+}
+
+console.log(`package: ${baseline ? pkgSpec : "this checkout (npm pack)"}`);
+for (const r of summary) console.log(`${r.label.padEnd(14)} install=${r.install.padEnd(4)} types=${r.types.padEnd(4)} runtime=${r.runtime.padEnd(16)} ${r.detail}`);
+process.exit(summary.every((r) => r.install === "ok" && r.types === "ok" && /^\d+ pass \/ 0 fail$/.test(r.runtime)) ? 0 : 1);
diff --git a/test/helpers.mjs b/test/helpers.mjs
new file mode 100644
index 0000000..d53a2d6
--- /dev/null
+++ b/test/helpers.mjs
@@ -0,0 +1,71 @@
+// Shared helpers. Nothing here fakes Exa: requests go to the real
+// https://api.exa.ai/search, and request bodies are checked against Exa's
+// published OpenAPI spec. A key is never needed; a deliberately invalid key
+// makes the real API answer 401 INVALID_API_KEY.
+export const INVALID_KEY = "invalid-key-for-tests";
+export const SPEC_URL = "https://exa.ai/docs/exa-spec.json";
+
+/** Wraps the real fetch, recording each call and passing it through unchanged. */
+export function recordingFetch() {
+  const calls = [];
+  const fn = async (url, init) => {
+    calls.push({ url: String(url), init, body: init?.body ? JSON.parse(init.body) : undefined });
+    return globalThis.fetch(url, init);
+  };
+  return { fetch: fn, calls };
+}
+
+let specPromise;
+export function loadSpec() {
+  specPromise ??= globalThis.fetch(SPEC_URL).then((r) => {
+    if (!r.ok) throw new Error(`spec fetch failed: ${r.status}`);
+    return r.json();
+  });
+  return specPromise;
+}
+
+/** Collects every property path in a request body that the spec marks deprecated or legacy. */
+export function deprecatedPaths(spec, body) {
+  const schemas = spec.components.schemas;
+  const hits = [];
+  const resolve = (s) => (s && s.$ref ? schemas[s.$ref.split("/").pop()] : s);
+  const lifecycleOf = (s) => {
+    s = resolve(s);
+    if (!s) return undefined;
+    if (s["x-exa-lifecycle"]) return s["x-exa-lifecycle"];
+    for (const k of ["anyOf", "oneOf"]) for (const sub of s[k] ?? []) {
+      const r = resolve(sub);
+      // Branches with a const (enum values like type: "fast") are checked per value below.
+      if (r && r["x-exa-lifecycle"] && r.type !== "null" && !("const" in r)) return r["x-exa-lifecycle"];
+    }
+    return undefined;
+  };
+  const objectSchema = (s) => {
+    s = resolve(s);
+    if (!s) return undefined;
+    if (s.properties) return s;
+    for (const k of ["anyOf", "oneOf"]) for (const sub of s[k] ?? []) {
+      const r = objectSchema(sub);
+      if (r) return r;
+    }
+    return undefined;
+  };
+  const walk = (schema, value, path) => {
+    const obj = objectSchema(schema);
+    if (!obj || typeof value !== "object" || value === null) return;
+    for (const [k, v] of Object.entries(value)) {
+      const prop = obj.properties[k];
+      if (!prop) continue;
+      const life = lifecycleOf(prop);
+      if (life === "deprecated" || life === "legacy") hits.push(`${path}${k}`);
+      // const-valued enums (e.g. type: "fast") carry lifecycle on the matching branch
+      for (const sub of resolve(prop).anyOf ?? []) {
+        const r = resolve(sub);
+        if (r && r.const === v && r["x-exa-lifecycle"]) hits.push(`${path}${k}=${v}`);
+      }
+      walk(prop, v, `${path}${k}.`);
+    }
+  };
+  walk(schemas.SearchRequest, body, "");
+  return hits;
+}
diff --git a/test/websearch.test.mjs b/test/websearch.test.mjs
new file mode 100644
index 0000000..5543c32
--- /dev/null
+++ b/test/websearch.test.mjs
@@ -0,0 +1,135 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import Ajv2020 from "ajv/dist/2020.js";
+import { webSearch, ExaApiError } from "../dist/index.js";
+import { INVALID_KEY, recordingFetch, loadSpec, deprecatedPaths } from "./helpers.mjs";
+
+const opts = (signal) => ({ toolCallId: "t1", messages: [], abortSignal: signal, context: {} });
+
+test("default request body is valid for Exa's SearchRequest schema and uses no deprecated fields", async () => {
+  const spec = await loadSpec();
+  const rec = recordingFetch();
+  const search = webSearch({ apiKey: INVALID_KEY, fetch: rec.fetch });
+  await assert.rejects(search.execute({ query: "latest AI SDK release" }, opts()));
+  const body = rec.calls[0].body;
+
+  const ajv = new Ajv2020({ strict: false, allErrors: true, validateFormats: false });
+  ajv.addSchema(spec, "exa-spec");
+  const validate = ajv.compile({ $ref: "exa-spec#/components/schemas/SearchRequest" });
+  assert.ok(validate(body), JSON.stringify(validate.errors));
+  assert.deepEqual(deprecatedPaths(spec, body), []);
+  assert.equal(body.contents.livecrawl, undefined);
+});
+
+test("documented example from exa.ai/docs/integrations/vercel/ai-sdk forwards maxAgeHours", async () => {
+  const spec = await loadSpec();
+  const rec = recordingFetch();
+  // Options copied from the "Configure search" example on the Exa docs page.
+  const search = webSearch({
+    apiKey: INVALID_KEY,
+    fetch: rec.fetch,
+    type: "auto",
+    numResults: 6,
+    category: "company",
+    contents: { text: { maxCharacters: 1000 }, maxAgeHours: 1, summary: true },
+  });
+  await assert.rejects(search.execute({ query: "top AI companies in Europe founded after 2018" }, opts()));
+  const body = rec.calls[0].body;
+  assert.equal(body.contents.maxAgeHours, 1);
+  assert.equal(body.contents.livecrawl, undefined);
+  assert.deepEqual(deprecatedPaths(spec, body), []);
+});
+
+test("lite search body only uses parameters the spec allows for lite", async () => {
+  const spec = await loadSpec();
+  const liteDesc = spec.components.schemas.SearchRequest.properties.type.anyOf.find((s) => s.const === "lite").description;
+  const rec = recordingFetch();
+  const search = webSearch({ apiKey: INVALID_KEY, fetch: rec.fetch, type: "lite" });
+  await assert.rejects(search.execute({ query: "q" }, opts()));
+  const body = rec.calls[0].body;
+  const paths = [];
+  for (const [k, v] of Object.entries(body)) {
+    if (k === "contents") for (const ck of Object.keys(v)) paths.push(`contents.${ck}`);
+    else paths.push(k);
+  }
+  for (const p of paths.filter((p) => p !== "type")) assert.ok(liteDesc.includes("`" + p + "`"), `${p} is not in lite's allow-list`);
+});
+
+test("livecrawl combined with maxAgeHours is rejected up front", () => {
+  assert.throws(
+    () => webSearch({ apiKey: INVALID_KEY, contents: { livecrawl: "always", maxAgeHours: 0 } }),
+    /cannot be combined/,
+  );
+});
+
+test("real API error surfaces as ExaApiError with status, tag and requestId", async () => {
+  const search = webSearch({ apiKey: INVALID_KEY });
+  const err = await search.execute({ query: "x" }, opts()).catch((e) => e);
+  assert.ok(err instanceof ExaApiError, String(err));
+  assert.equal(err.status, 401);
+  assert.equal(err.tag, "INVALID_API_KEY");
+  assert.match(err.requestId, /^[0-9a-f]{16,}$/);
+  assert.match(err.message, /^Failed to search with Exa: Exa API error: 401 - /);
+});
+
+test("sends the integration headers and the configured key", async () => {
+  const rec = recordingFetch();
+  const search = webSearch({ apiKey: INVALID_KEY, fetch: rec.fetch });
+  await search.execute({ query: "x" }, opts()).catch(() => {});
+  const h = rec.calls[0].init.headers;
+  assert.equal(rec.calls[0].url, "https://api.exa.ai/search");
+  assert.equal(h["x-api-key"], INVALID_KEY);
+  assert.equal(h["x-exa-integration"], "vercel-ai-sdk");
+  assert.match(h["User-Agent"], /^exa-vercel-ai-sdk \d+\.\d+\.\d+/);
+});
+
+test("missing key fails before any request", async () => {
+  const saved = process.env.EXA_API_KEY;
+  delete process.env.EXA_API_KEY;
+  try {
+    const rec = recordingFetch();
+    const search = webSearch({ fetch: rec.fetch });
+    await assert.rejects(search.execute({ query: "x" }, opts()), /EXA_API_KEY is required/);
+    assert.equal(rec.calls.length, 0);
+  } finally {
+    if (saved !== undefined) process.env.EXA_API_KEY = saved;
+  }
+});
+
+test("already-aborted signal: rejects with AbortError and makes no request (#22)", async () => {
+  const rec = recordingFetch();
+  const search = webSearch({ apiKey: INVALID_KEY, fetch: rec.fetch });
+  const c = new AbortController();
+  c.abort();
+  const err = await search.execute({ query: "x" }, opts(c.signal)).catch((e) => e);
+  assert.equal(err?.name, "AbortError");
+  assert.equal(rec.calls.length, 0);
+});
+
+test("abort mid-flight cancels the real HTTP request (#22)", async () => {
+  const rec = recordingFetch();
+  const search = webSearch({ apiKey: INVALID_KEY, fetch: rec.fetch });
+  const c = new AbortController();
+  const started = Date.now();
+  const pending = search.execute({ query: "x" }, opts(c.signal));
+  c.abort();
+  const err = await Promise.resolve(pending).catch((e) => e);
+  assert.equal(err?.name, "AbortError");
+  assert.equal(rec.calls.length, 1);
+  assert.equal(rec.calls[0].init.signal, c.signal);
+  assert.ok(Date.now() - started < 1000);
+});
+
+test("abort while the request is on the wire settles promptly (#22)", async () => {
+  const rec = recordingFetch();
+  const search = webSearch({ apiKey: INVALID_KEY, fetch: rec.fetch });
+  const c = new AbortController();
+  const pending = Promise.resolve(search.execute({ query: "x" }, opts(c.signal)));
+  setTimeout(() => c.abort(new DOMException("User stopped", "AbortError")), 20);
+  const started = Date.now();
+  const outcome = await pending.then(() => "resolved", (e) => e?.name);
+  // Either the abort landed first (AbortError), or Exa answered inside 20 ms
+  // (ExaApiError). Both are fine; hanging is not.
+  assert.ok(outcome === "AbortError" || outcome === "ExaApiError", String(outcome));
+  assert.ok(Date.now() - started < 2000);
+});
